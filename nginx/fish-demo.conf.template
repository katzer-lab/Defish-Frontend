server {
    listen 80;
    server_name HOST_IP_OR_DOMEN;

    # Photos are uploaded through this server. nginx refuses request bodies over 1 MB by default;
    # the API accepts up to 10 MB (MAX_UPLOAD_MB), so leave room for the multipart overhead.
    client_max_body_size 12m;

    # React build and static files
    location / {
        root /path/to/Defish-frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
    
    # API proxy: the backend's docker-compose file publishes the API on 127.0.0.1:8001
    location /api/ {
        proxy_pass http://127.0.0.1:8001/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}